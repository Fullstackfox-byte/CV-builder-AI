# ---------- Server ----------
PORT=5000
CLIENT_URL=http://localhost:5173
# Optional: the app works without MongoDB (CVs are kept in the browser).
MONGO_URI=mongodb://127.0.0.1:27017/cvforge

# ---------- AI (server-side only, NEVER put keys in client code) ----------
# local     -> built-in rule-based engine (no key needed)
# anthropic -> Claude API    | openai -> OpenAI-compatible API
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
